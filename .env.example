# 复制为 .env 后填入你自己的 key。.env 已被 .gitignore 忽略，不会进仓库。
LLM_API_KEY=
LLM_BASE_URL=https://aihubmix.com/v1
LLM_MODEL=gpt-4o-mini
# 可选。Qwen3 等带隐藏思考的模型设为 false 可显著降低延迟；其他模型留空
LLM_ENABLE_THINKING=
# 向量模型。中转站上可用的有 text-embedding-v4、text-embedding-3-small
EMBEDDING_MODEL=text-embedding-v4
# 检索增强。重排默认开，改写默认关，依据见 scripts/compare_retrieval.py
RETRIEVAL_RERANK=true
RETRIEVAL_REWRITE=false
# 会话记忆。先执行 docker compose up -d redis
REDIS_URL=redis://localhost:6379/0
